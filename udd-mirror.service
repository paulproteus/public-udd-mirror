[Unit]
Description=UDD mirror
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=1
User=udd-mirror
ExecStart=/bin/bash -c 'cd /srv/udd-mirror && git pull && docker rm -f udd-mirror && docker build . && docker run --rm --name udd-mirror -p 0.0.0.0:5432:5432 --net udd-mirror-network --mount source=udd-mirror-postgres,target=/var/lib/postgresql --mount source=udd-mirror-logs,target=/var/www/html/logs --ip 172.18.0.2 --shm-size=256m $(docker build -q .)'

[Install]
WantedBy=multi-user.target
